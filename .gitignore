# =============================================================================
# Nexa .gitignore
# =============================================================================

# --- Python bytecode ---------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.pyo

# --- Virtual environments ----------------------------------------------------
.venv/
venv/
env/
.env

# --- Distribution / packaging ------------------------------------------------
dist/
build/
*.egg-info/
*.egg

# --- ML artifacts (large files — store in cloud, not git) --------------------
checkpoints/
*.pt
*.pth
*.bin
*.safetensors
*.onnx

# --- Data (datasets can be gigabytes) ----------------------------------------
# Keep the dataset pipeline structure, docs, metadata, manifests, reports, and
# tiny permitted samples in git. Keep real dataset payloads out of git.
data/memories.json

data/raw/*
!data/raw/.gitkeep
!data/raw/README.md
!data/raw/*/
data/raw/*/*
!data/raw/*/metadata.yaml
!data/raw/*/_metadata.yaml
!data/raw/nexa_demo/*.txt

data/cleaned/*
!data/cleaned/.gitkeep
!data/cleaned/README.md
!data/cleaned/*/
data/cleaned/*/*
!data/cleaned/*/metadata.yaml

data/deduplicated/*
!data/deduplicated/.gitkeep
!data/deduplicated/README.md
!data/deduplicated/*/
data/deduplicated/*/*
!data/deduplicated/*/metadata.yaml

data/splits/*
!data/splits/train/
!data/splits/validation/
data/splits/train/*
!data/splits/train/.gitkeep
!data/splits/train/README.md
data/splits/validation/*
!data/splits/validation/.gitkeep
!data/splits/validation/README.md

data/processed/*
!data/processed/.gitkeep
!data/processed/README.md
!data/processed/train/
!data/processed/validation/
!data/processed/tokenizer/
data/processed/train/*
!data/processed/train/.gitkeep
!data/processed/train/README.md
data/processed/validation/*
!data/processed/validation/.gitkeep
!data/processed/validation/README.md

# Processed tokenizer artifacts are generated from source data. Existing tiny
# demo artifacts may remain tracked, but new generated files should stay local.
data/processed/tokenizer/*

# Manifests and reports are expected to be small, reviewable text artifacts.
!data/manifests/
!data/reports/

# --- Logs --------------------------------------------------------------------
logs/
*.log

# --- Jupyter Notebooks (use scripts instead) ---------------------------------
.ipynb_checkpoints/
*.ipynb

# --- WandB -------------------------------------------------------------------
wandb/

# --- IDEs --------------------------------------------------------------------
.vscode/
.idea/
*.sublime-project
*.sublime-workspace

# --- OS files ----------------------------------------------------------------
.DS_Store
Thumbs.db
desktop.ini

# --- TensorBoard -------------------------------------------------------------
runs/

# --- Testing -----------------------------------------------------------------
.pytest_cache/
.coverage
htmlcov/
.mypy_cache/
.ruff_cache/

# --- Sensitive configs (API keys, secrets) -----------------------------------
.env.local
secrets.yaml
